        this.showToast('Success', 'Product deleted successfully', 'success');

        // Refresh the data using refreshApex
        await refreshApex(this._wiredProductsResult);

    } catch (error) {
        this.deleteErrorMessage = 'Error deleting product: ' + (error.body ? error.body.message : error.message);
        console.error('Deletion error:', error);
    } finally {
        this.showSpinner = false;
        this.showDeleteModal = false;
        this.pendingDeleteId = null;
    }
}

