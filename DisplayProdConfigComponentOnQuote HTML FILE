        </div>
    </lightning-card>

    <!-- Child Component Edit Product -->
    <template if:true={editProductModal}>
        <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading"
            class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container slds-modal_x-large modal-width">
                <!-- Modal Header -->
                <header class="slds-modal__header">
                    <h2 class="slds-text-heading_medium">Edit Products</h2>
                    <lightning-button-icon icon-name="utility:close" alternative-text="Close" variant="bare"
                        onclick={closeModal} class="slds-modal__close"></lightning-button-icon>
                </header>

                <!-- Modal Body: Render Child Component -->
                <div class="slds-modal__content slds-p-around_medium">
                    <c-product-configurator-edit-component record-id={recordId}
                        pricebook-id={selectedPricebook}></c-product-configurator-edit-component>
                    <!-- <c-product-configurator-component></c-product-configurator-component> -->
                </div>

                <!-- Modal Footer -->
                <footer class="slds-modal__footer">
                    <lightning-button label="Cancel" onclick={closeModal}
                        style="margin-right : 10px;"></lightning-button>
                    <lightning-button label="Save" onclick={handleEditProductSave}></lightning-button>
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </template>

    <template if:true={addProductModal}>
        <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading"
            class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container slds-modal_x-large modal-width">
                <!-- Modal Header -->
                <header class="slds-modal__header">
                    <h2 class="slds-text-heading_medium">Add Product</h2>
                    <lightning-button-icon icon-name="utility:close" alternative-text="Close" variant="bare"
                        onclick={closeModal} class="slds-modal__close"></lightning-button-icon>
                </header>

                <!-- Modal Body: Render Child Component -->
                <div class="slds-modal__content slds-p-around_medium">
                    <c-product-configurator-component pricebook-id={selectedPricebook}
                        record-id={recordId}></c-product-configurator-component>
                </div>

                <!-- Modal Footer
                <footer class="slds-modal__footer">
                    <lightning-button label="Cancel" onclick={closeModal}
                        style="margin-right : 10px;"></lightning-button>
                    <lightning-button label="Save" onclick={handleSave}></lightning-button>
                </footer> -->
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </template>


    <template if:true={openPricebookModal}>
        <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading"
            class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container slds-modal_x-small modal-width">
                <!-- Modal Header -->
                <header class="slds-modal__header">
                    <h2 class="slds-text-heading_medium">Select Pricebook</h2>
                    <lightning-button-icon icon-name="utility:close" alternative-text="Close" variant="bare"
                        onclick={closeModal} class="slds-modal__close"></lightning-button-icon>
                </header>

                <!-- Modal Body: Render Pricebook  -->
                <div class="slds-modal__content slds-p-around_medium">
                    <lightning-combobox name="pricebook" label="Pricebook" value={selectedPricebook}
                        placeholder="Select a Pricebook" options={pricebooks} onchange={handleChange}>
                    </lightning-combobox>
                </div>
                <!-- Modal Footer-->

                <footer class="slds-modal__footer">
                    <lightning-button label="Cancel" onclick={closeModal}
                        style="margin-right : 10px;"></lightning-button>
                    <lightning-button label="Save" onclick={handleSave}></lightning-button>
                </footer>

            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </template>

</template>
