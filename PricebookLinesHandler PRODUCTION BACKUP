public class PricebookLinesHandler {

    public static void updateRelatedPricebookEntries(List<Pricebook_lines__c> newLines) {
        if (newLines == null || newLines.isEmpty()) return;

        // ---------------------------
        // Step 1: Collect header IDs & product codes
        // ---------------------------
        Set<String> headerIds = new Set<String>();
        Set<String> productCodes = new Set<String>();

        for (Pricebook_lines__c pl : newLines) {
            if (String.isNotBlank(pl.LIST_HEADER_ID__c)) headerIds.add(pl.LIST_HEADER_ID__c);
            if (String.isNotBlank(pl.ITEM_CODE__c)) productCodes.add(pl.ITEM_CODE__c);
        }

        if (headerIds.isEmpty() || productCodes.isEmpty()) return;

        // ---------------------------
        // Step 2: Fetch active Pricebooks
        // ---------------------------
        Map<String, Pricebook2> pbMap = new Map<String, Pricebook2>();
        for (Pricebook2 pb : [
            SELECT Id, Price_Book_External_Id__c, CurrencyIsoCode, IsActive
            FROM Pricebook2
            WHERE Price_Book_External_Id__c IN :headerIds
            AND IsActive = TRUE
        ]) {
            pbMap.put(pb.Price_Book_External_Id__c, pb);
        }
        if (pbMap.isEmpty()) return;

        // ---------------------------
        // Step 3: Map ProductCode to Product Id
        // ---------------------------
        Map<String, Id> productCodeToId = new Map<String, Id>();
        for (Product2 p : [
            SELECT Id, ProductCode
            FROM Product2
            WHERE ProductCode IN :productCodes
        ]) {
            productCodeToId.put(p.ProductCode, p.Id);
        }
        if (productCodeToId.isEmpty()) return;

        // ---------------------------
        // Step 4: Fetch existing PricebookEntries
        // ---------------------------
        Set<Id> pbIds = new Set<Id>();
        for (Pricebook2 pb : pbMap.values()) pbIds.add(pb.Id);

        Map<String, List<PricebookEntry>> pbeGroupMap = new Map<String, List<PricebookEntry>>();
        for (PricebookEntry pbe : [
            SELECT Id, Pricebook2Id, Product2Id, UnitPrice, IsActive,
                   Start_Date__c, End_Date__c
            FROM PricebookEntry
            WHERE Pricebook2Id IN :pbIds
            AND Product2Id IN :productCodeToId.values()
        ]) {
            String key = pbe.Pricebook2Id + '_' + pbe.Product2Id;
            if (!pbeGroupMap.containsKey(key)) pbeGroupMap.put(key, new List<PricebookEntry>());
            pbeGroupMap.get(key).add(pbe);
        }

        // ---------------------------
        // Step 5: Prepare lists for DML
        // ---------------------------
        List<PricebookEntry> pbeToInsert = new List<PricebookEntry>();
        List<PricebookEntry> pbeToUpdate = new List<PricebookEntry>();
        Date today = Date.today();

        // ---------------------------
        // Step 6: Process each Pricebook line
        // ---------------------------
        for (Pricebook_lines__c pl : newLines) {

            // Skip if product or pricebook not found
            if (!productCodeToId.containsKey(pl.ITEM_CODE__c)) continue;
            if (!pbMap.containsKey(pl.LIST_HEADER_ID__c)) continue;

            Id prodId = productCodeToId.get(pl.ITEM_CODE__c);
            Pricebook2 pb = pbMap.get(pl.LIST_HEADER_ID__c);
            String key = pb.Id + '_' + prodId;

            // Check if line is valid for today
            Boolean dateValid = false;
            if (pl.START_DATE_ACTIVE__c != null && pl.END_DATE_ACTIVE__c != null) {
                dateValid = (pl.START_DATE_ACTIVE__c <= today && pl.END_DATE_ACTIVE__c >= today);
            }

            // Get existing PBEs for this pricebook & product
            List<PricebookEntry> existingList = pbeGroupMap.containsKey(key) ? pbeGroupMap.get(key) : null;
            PricebookEntry activePBE;
            PricebookEntry inactivePBE;

            if (existingList != null) {
                for (PricebookEntry e : existingList) {
                    if (e.IsActive) {
                        activePBE = e; // Prefer active PBE
                        break;
                    }
                    if (inactivePBE == null) inactivePBE = e; // Pick first inactive
                }
            }

            // ---------------------------
            // CASE 1: Active PBE exists
            // ---------------------------
            if (activePBE != null) {
                if (dateValid) {
                    Boolean needUpdate = false;
                    if (activePBE.UnitPrice != pl.UNIT_COST__c) {
                        activePBE.UnitPrice = pl.UNIT_COST__c;
                        needUpdate = true;
                    }
                    if (activePBE.Start_Date__c != pl.START_DATE_ACTIVE__c) {
                        activePBE.Start_Date__c = pl.START_DATE_ACTIVE__c;
                        needUpdate = true;
                    }
                    if (activePBE.End_Date__c != pl.END_DATE_ACTIVE__c) {
                        activePBE.End_Date__c = pl.END_DATE_ACTIVE__c;
                        needUpdate = true;
                    }
                    if (!activePBE.IsActive) {
                        activePBE.IsActive = true;
                        needUpdate = true;
                    }
                    if (needUpdate) pbeToUpdate.add(activePBE);
                } else {
                    // Invalid → deactivate
                    if (activePBE.IsActive) pbeToUpdate.add(activePBE);
                    activePBE.IsActive = false;
                }
                continue;
            }

            // ---------------------------
            // CASE 2: No active, but inactive exists
            // ---------------------------
            if (inactivePBE != null) {
                if (dateValid) {
                    Boolean needUpdate = false;
                    if (!inactivePBE.IsActive) {
                        inactivePBE.IsActive = true;
                        needUpdate = true;
                    }
                    if (inactivePBE.UnitPrice != pl.UNIT_COST__c) {
                        inactivePBE.UnitPrice = pl.UNIT_COST__c;
                        needUpdate = true;
                    }
                    if (inactivePBE.Start_Date__c != pl.START_DATE_ACTIVE__c) {
                        inactivePBE.Start_Date__c = pl.START_DATE_ACTIVE__c;
                        needUpdate = true;
                    }
                    if (inactivePBE.End_Date__c != pl.END_DATE_ACTIVE__c) {
                        inactivePBE.End_Date__c = pl.END_DATE_ACTIVE__c;
                        needUpdate = true;
                    }
                    if (needUpdate) pbeToUpdate.add(inactivePBE);
                }
                continue;
            }

            // ---------------------------
            // CASE 3: No existing PBE → insert new
            // ---------------------------
            if (dateValid) {
                PricebookEntry newPBE = new PricebookEntry(
                    Pricebook2Id = pb.Id,
                    Product2Id = prodId,
                    UnitPrice = pl.UNIT_COST__c,
                    IsActive = true,
                    UseStandardPrice = false,
                    CurrencyIsoCode = pb.CurrencyIsoCode,
                    Start_Date__c = pl.START_DATE_ACTIVE__c,
                    End_Date__c = pl.END_DATE_ACTIVE__c
                );
                pbeToInsert.add(newPBE);
            }
        }

        // ---------------------------
        // Step 7: Execute DML
        // ---------------------------
        if (!pbeToUpdate.isEmpty()) update pbeToUpdate;
        if (!pbeToInsert.isEmpty()) insert pbeToInsert;
    }

	//UPDATE CURRENCY
	
	 public static void updateCurrency(List<Pricebook_lines__c> newList){
        for(Pricebook_lines__c pl : newList){

            // If Header = 04 → USD
            if(pl.LIST_HEADER_ID__c == '04'){
                pl.CurrencyIsoCode = 'USD';
            }

            // If Header = 05 → EUR
            else if(pl.LIST_HEADER_ID__c == '05'){
                pl.CurrencyIsoCode = 'EUR';
            }

            // If Header is blank/null → INR
            else if(String.isBlank(pl.LIST_HEADER_ID__c)){
                pl.CurrencyIsoCode = 'INR';
            }
        }
    }





}
