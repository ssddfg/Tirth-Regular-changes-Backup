                                    <strong style="padding-left: 2%;">{group.productGroup}</strong>
                                    <span class="badge" if:true={group.cropSolution}>{group.cropSolution}</span>
                                    <span class="badge" if:true={group.application}>{group.application}</span>
                                    <span class="badge" if:true={group.soilType}>{group.soilType}</span>
                                    <span class="badge" if:true={group.productSeries}>{group.productSeries}</span>
                                </td>
                            </tr>
                            <template for:each={group.products} for:item="product">
                                <tr key={product.Id} class="product-row">
                                    <td style="text-align: right; padding-left:1.9%">🔶 </td>
                                    <!-- <td if:true={product.AltBOM} colspan="5">
                                        {product.ProductName}
                                        <span class="badge product-type">{product.ProductType}</span>
