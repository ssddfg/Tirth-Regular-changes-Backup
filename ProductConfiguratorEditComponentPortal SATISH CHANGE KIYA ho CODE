handleSelectBom(event) {

    const parentLineItemId = event.currentTarget.dataset.id;

    console.log('Clicked Line Item Id ::', parentLineItemId);
    console.log('Grouped Products ::', JSON.stringify(this.groupedProducts));

    const parentProduct = this.groupedProducts.find(
        p => p.id === parentLineItemId
    );

    if (!parentProduct) {
        this.showToast('Error', 'Parent product not found', 'error');
        console.error('Parent not found');
        return;
    }

    this.selectedBomParentId = parentProduct.productId;

    console.log('Product2Id sent to Apex ::', this.selectedBomParentId);

    getBOMGroups({ parentProductId: this.selectedBomParentId })
        .then(result => {

            const groupMap = {};

            result.forEach(item => {
                const group = item.Alternative_BOM__c;

                if (!groupMap[group]) {
                    groupMap[group] = [];
                }

                groupMap[group].push(item);
            });

            this.bomGroups = Object.entries(groupMap).map(([key, items]) => ({
                groupKey: key,
                items,
                showAll: false,
                visibleItems: items.slice(0, 3),
                hasMoreItems: items.length > 3,
                toggleLabel: 'View More',
                groupDescription: items.length > 0 ? items[0].Description : 'BOM'
            }));

            this.showBomModal = true;
        })
        .catch(error => {
            console.error('Error fetching BOMs:', error);
            this.showToast('Error', 'Failed to fetch BOM groups', 'error');
        });
}
getVisibleItems(group) {
    return group.showAll ? group.items : group.items.slice(0, 3);
}

getToggleLabel(group) {
    return group.showAll ? 'View Less' : 'View More';
}

toggleGroupView(event) {
    const groupKey = event.target.dataset.groupKey;
    this.bomGroups = this.bomGroups.map(group => {
        if (group.groupKey === groupKey) {
            const showAll = !group.showAll;
            return {
                ...group,
                showAll,
                visibleItems: showAll ? group.items : group.items.slice(0, 3),
                toggleLabel: showAll ? 'View Less' : 'View More'

            };
        }
        return group;
    });
}

@track newBOMLineItems = [];

handleBOMGroupSelect(event) {

    const selectedGroup = event.currentTarget.dataset.groupKey;

    const parentProduct = this.groupedProducts.find(
        p => p.productId === this.selectedBomParentId
    );

    if (!parentProduct) {
        this.showToast('Error', 'Parent product not found', 'error');
        return;
    }

    const selectedParentLineItemId = parentProduct.id;

    const selectedGroupItems =
        this.bomGroups.find(g => g.groupKey === selectedGroup)?.items || [];

    this.showSpinner = true;

    createBOMLineItems({
        parentLineItemId: selectedParentLineItemId,
        bomComponents: selectedGroupItems
    })
        .then(() => {
            this.showToast('Success', 'BOM components successfully added', 'success');
            return refreshApex(this._wiredProductsResult);
        })
        .catch(error => {
            console.error('BOM creation failed:', error);
            this.showToast('Error', 'Failed to add BOM components.', 'error');
        })
        .finally(() => {
            this.showSpinner = false;
            this.closeBomModal();
        });
}

closeBomModal() {
    this.showBomModal = false;
    this.selectedBomParentId = null;
    this.bomGroups = [];
}



