<template>
    <lightning-spinner if:true={showSpinner} alternative-text="Loading..." size="medium"></lightning-spinner>

    <lightning-card variant="Narrow" title={componentTitle} icon-name="standard:product" class="card">
        <lightning-button-group slot="actions">
            <lightning-button label="Add Products" onclick={openModal}></lightning-button>
            <lightning-button label="Edit Products" onclick={openModal}></lightning-button><!--if:false={noProducts}-->
            <lightning-button label="Select Pricebook" onclick={openModal}></lightning-button>
            <!-- if:false={noProducts}-->
            <!-- <lightning-button label="Save"></lightning-button> -->
        </lightning-button-group>
        <div class="table-container slds-scrollable">
            <template if:true={noProducts}>
                <c-illustration-component display-text="No Products Added!"></c-illustration-component>
            </template>
            <template if:false={noProducts}>
                <table class="slds-table slds-table_bordered slds-table_cell-buffer custom-table">
                    <thead>
                        <tr>
                            <th colspan="3">Product Name</th>
                            <th class="text-align-center">NDP Price</th>
                            <th class="text-align-center">Sales Price</th>
                            <th class="text-align-center">Quantity</th>
                            <th class="text-align-center">Total Sales Price</th>
