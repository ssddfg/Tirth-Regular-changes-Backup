                            <th class="text-align-center text-align-left">Add. Instruction</th>-->
                            <th class="text-align-center text-align-left">Total Value Actual Price</th>
                            <th class="text-align-center text-align-left">From Rate Contract</th>
                            <th class="text-align-center">Deviation from NDP</th>
                            <th class="text-align-center">Deviation from RC</th>
                            <th class="text-align-center">NDP INCO Price</th>
                            
                            

