    @AuraEnabled(cacheable=true)
    public static List<Product_Configurator__c> getEndProducts(Id productGroupId) {
        // Step 1: Fetch all Product Series IDs in a single query
        List<Product_Configurator__c> productSeriesList = [
            SELECT Id
            FROM Product_Configurator__c
            WHERE Product_Category_Type__c = 'Product Series'
            AND Parent_Product_Configurator__c = :productGroupId
        ];
        
        // Extracting Series IDs from the query result
        Set<Id> productSeriesIds = new Set<Id>();
        for (Product_Configurator__c series : productSeriesList) {
            productSeriesIds.add(series.Id);
        }
        
        // Step 2: Fetch all End Products related to those Product Series
        if (productSeriesIds.isEmpty()) {
            return new List<Product_Configurator__c>(); // Return empty list if no series found
        }
        
        return [
            SELECT Id, Name, Parent_Product_Configurator__r.Name
            FROM Product_Configurator__c
            WHERE Product_Category_Type__c = 'End Product'
            AND Parent_Product_Configurator__c IN :productSeriesIds
        ];
    }
    
    
    
    @AuraEnabled(cacheable=true)
    public static String getProductImageURL(Id productId) {
        List<ContentDocumentLink> links = [
            SELECT ContentDocumentId 
            FROM ContentDocumentLink 
            WHERE LinkedEntityId = :productId 
            LIMIT 1
        ];
        
        if (!links.isEmpty()) {
            String contentDocId = links[0].ContentDocumentId;
            return '/sfc/servlet.shepherd/version/download/' + contentDocId;
        }
        return null;
    }

