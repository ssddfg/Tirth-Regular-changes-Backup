    /**
     * Generates a random integer between 1 and 1000 (inclusive)
     * @return Integer - Random number between 1-1000
     */
    public static Integer generateRandomNumber() {
        // Create an instance of the Crypto class for secure random number generation
        Integer randomValue = Crypto.getRandomInteger();
        
        // Ensure the value is positive (absolute value)
        Integer positiveValue = Math.abs(randomValue);
        
        // Modulo 1000 to get a value between 0-999, then add 1 to make it 1-1000
        Integer randomNumber = Math.mod(positiveValue, 1000) + 1;
        
        return randomNumber;
    }
    
