removeDeletedProduct(deletedId) {

    this.groupedProducts = this.groupedProducts.map(parent => {

        if (parent.id === deletedId) return null;

        const updatedChildGroups = parent.childGroups.map(group => ({
            ...group,
            items: group.items.filter(item => item.Id !== deletedId)
        })).filter(group => group.items.length > 0);

        return {
            ...parent,
            childGroups: updatedChildGroups
        };

    }).filter(parent => parent !== null);

    this.products = this.products.filter(prod => prod.id !== deletedId);
}

