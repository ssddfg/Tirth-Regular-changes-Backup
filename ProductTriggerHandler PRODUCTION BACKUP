public class ProductTriggerHandler extends TriggerHandler {
    private List<Product2> newRecords;
    private Map<Id, Product2> oldRecordsMap;

    // Static map to cache record type IDs
    private static Map<String, Id> recordTypeMap;
    private static Map<String, Id> productByExternalIdMap;

    public ProductTriggerHandler() {
        System.debug('Inside ProductTriggerHandler');
        this.newRecords = Trigger.new;
        this.oldRecordsMap = (Trigger.oldMap != null) ? (Map<Id, Product2>) Trigger.oldMap : new Map<Id, Product2>();
    }

    public override void afterInsert() {
        System.debug('Executing afterInsert in ProductTriggerHandler');
        
        // 1. Create default INR, USD, EUR entries
        Product2MaterialCodeManager.createDefaultCurrencyPricebookEntries(newRecords);

    	// 2. Create PricebookEntries from Pricebook_lines__c
    		createPricebookEntries(newRecords); 
    }

		public override void afterUpdate() 
        {
            // 1. update PricebookEntries from Pricebook_lines__c
    		createPricebookEntries(newRecords);
		}

    public override void beforeInsert() {
        System.debug('Executing beforeInsert in ProductTriggerHandler');
        assignRecordTypes();
        mapProductCodeToExternalId();
        setProductLookupForAlternateBOM();
        Product2MaterialCodeManager.validateUniqueMaterialCode(newRecords);
        Product2MaterialCodeManager.validateAltBOM(newRecords);
    }

    public override void beforeUpdate() {
        assignRecordTypes();
        mapProductCodeToExternalId();
        setProductLookupForAlternateBOM();
        Product2MaterialCodeManager.validateAltBOM(newRecords);

    }

    // Assign record type based on Product_Type__c
    private void assignRecordTypes() {
        Map<String, String> labelToDevName = new Map<String, String>{
            'Material'      => 'Material_Finished_Product',
            'Alternate BOM' => 'Alternate_BOM',
            'Core'          => 'Core',
            'Spares'        => 'Spares'
        };

        if (recordTypeMap == null) {
            recordTypeMap = new Map<String, Id>();
            for (RecordType rt : [
                SELECT Id, DeveloperName
                FROM RecordType
                WHERE SObjectType = 'Product2'
                AND DeveloperName IN :labelToDevName.values()
            ]) {
                recordTypeMap.put(rt.DeveloperName, rt.Id);
            }
        }

        for (Product2 prod : newRecords) {
            if (String.isBlank(prod.Product_Type__c)) continue;

            if (oldRecordsMap != null && oldRecordsMap.containsKey(prod.Id)) {
                Product2 oldProd = oldRecordsMap.get(prod.Id);
                if (oldProd.Product_Type__c == prod.Product_Type__c) continue;
            }

            String devName = labelToDevName.get(prod.Product_Type__c);
            if (String.isNotBlank(devName) && recordTypeMap.containsKey(devName)) {
                prod.RecordTypeId = recordTypeMap.get(devName);
                System.debug('Assigned RecordTypeId: ' + prod.RecordTypeId + ' for type: ' + prod.Product_Type__c);
            }
        }
    }

    // Map ProductCode to External ID if not set
    private void mapProductCodeToExternalId() {
        for (Product2 prod : newRecords) {
            if (String.isNotBlank(prod.ProductCode) && String.isBlank(prod.Product_External_Id__c)) {
                prod.Product_External_Id__c = prod.ProductCode;
            }
        }
    }

    // Set Parent_Product__c based on ProductCode when RecordType = Alternate BOM
    private void setProductLookupForAlternateBOM() {
        Set<String> productCodesToSearch = new Set<String>();
        
        // Collect relevant ProductCodes
        for (Product2 prod : newRecords) {
            System.debug('List of records ' + prod);
            if (recordTypeMap != null &&
                recordTypeMap.containsKey('Alternate_BOM') &&
                prod.RecordTypeId == recordTypeMap.get('Alternate_BOM') &&
                String.isNotBlank(prod.ProductCode)) {
                productCodesToSearch.add(prod.ProductCode);
            }
        }

        System.debug('Product Codes to Search: ' + productCodesToSearch);

        if (!productCodesToSearch.isEmpty()) {
            Map<String, Id> codeToIdMap = new Map<String, Id>();
            for (Product2 p : [
                SELECT Id, ProductCode
                FROM Product2
                WHERE ProductCode IN :productCodesToSearch
            ]) {
                codeToIdMap.put(p.ProductCode, p.Id);
            }

            System.debug('Code to ID Map: ' + codeToIdMap);

            for (Product2 prod : newRecords) {
                if (recordTypeMap.containsKey('Alternate_BOM') &&
                    prod.RecordTypeId == recordTypeMap.get('Alternate_BOM') &&
                    codeToIdMap.containsKey(prod.ProductCode)) {
                    prod.Parent_Product__c = codeToIdMap.get(prod.ProductCode);
                }
            }
        }
    }


