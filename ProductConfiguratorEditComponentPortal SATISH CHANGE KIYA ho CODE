                            class="slds-m-bottom_small" style="padding-right:20px">
                        </lightning-button>
                        </template>
                                    <lightning-button label="Select This Group" variant="brand" data-group-key={group.groupKey}
                                        onclick={handleBOMGroupSelect} class="slds-m-top_x-small">
                                    </lightning-button>
                                </div>
                </template>
                </template>

                <template if:false={bomGroups.length}>
                    <div class="slds-align_absolute-center slds-p-around_large">
                        <div class="slds-text-heading_small">No BOM Groups Available</div>
                    </div>
            </template>
            </div>
        </div>
    </section>
    <div class="slds-backdrop slds-backdrop_open"></div>
</template> 



<!-- Delete Confirmation Modal -->
<template if:true={showDeleteModal}>
    <section role="dialog" class="slds-modal slds-fade-in-open slds-modal_small">
        <div class="slds-modal__container">
            <header class="slds-modal__header">
                <h2 class="slds-text-heading_medium">Confirm Deletion</h2>
            </header>
            
            <div class="slds-modal__content slds-p-around_medium">
                <p>Are you sure you want to delete this product?</p>
                <p class="slds-text-color_error slds-m-top_small" if:true={deleteErrorMessage}>
                    {deleteErrorMessage}
                </p>
            </div>
            
            <footer class="slds-modal__footer">
                <lightning-button label="Cancel" variant="neutral" onclick={handleDeleteCancel}></lightning-button>
                <lightning-button label="Delete" variant="destructive" onclick={handleDeleteConfirm}></lightning-button>
            </footer>
        </div>
    </section>
    <div class="slds-backdrop slds-backdrop_open"></div>
</template>

</template>


