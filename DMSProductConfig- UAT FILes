    applyFilters() {
    if (!this.fetchedEndProducts || this.fetchedEndProducts.length === 0) {
        this.endProducts = [];
        return;
    }

    // Create a Set of selected product IDs for easy lookup.
    const selectedIds = new Set(this.selectedProducts.map(p => p.productId));

    let filteredList = this.fetchedEndProducts;

    // Apply filters if any are selected
    if (Object.keys(this.selectedFilters).length > 0) {
        filteredList = this.fetchedEndProducts.filter(product => {
            return Object.keys(this.selectedFilters).every(filterKey => {
                if (!this.selectedFilters[filterKey]) return true;

                const productKey = this.mapFilterKeyToProductKey(filterKey);
                const productValue = product[productKey] || product[productKey.replace('__c', '')];
                const filterValue = this.selectedFilters[filterKey];

                return productValue && productValue === filterValue;
            });
        });
