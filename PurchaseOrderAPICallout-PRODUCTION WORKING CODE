    @AuraEnabled
    public static String sendPurchaseOrdersToSAP(String poIds) {
        System.debug('Input poIds: ' + poIds);

        // List of successfully synced POs
        List<Purchase_Order__c> successPOs = new List<Purchase_Order__c>();

        String resultMessage = '';
        Boolean isSuccess = false;

        // String username = 'TABAP';
        // String password = 'Tabap@1234';
        // String authHeader = 'Basic ' + EncodingUtil.base64Encode(Blob.valueOf(username + ':' + password));

        SAP_API_Endpoint__mdt apiConfig = getCredentials();
        // Authentication from metadata
        String username = apiConfig.Username__c;
        String password = apiConfig.Password__c;
        String authHeader = 'Basic ' + EncodingUtil.base64Encode(Blob.valueOf(username + ':' + password));

        List<Id> poIdList = new List<Id>();
        if (poIds.contains(',')) {
            for (String s : poIds.split(',')) {
                if (String.isNotBlank(s)) {
                    poIdList.add((Id) s.trim());
                }
            }
        } else {
            poIdList.add((Id) poIds.trim());
        }

        List<Purchase_Order__c> purchaseOrders = [
            SELECT 
                Id, Name, PO_NO__c, CreatedDate, Distribution_Channel__c, Parent_Account_Id__c,
                DOC_TYPE__c, SALES_ORG__c, Division__c, REQ_DATE_H__c, SALES_OFF__c,
                PURCH_NO_C__c, PURCH_DATE__c, PARTN_NUMB__c, PARTN_NUMB1__c, Account__c,
                CUST_PONO__c, SALES_GRP__c, SHIP_TYPE__c, INCO_VERSION__c, INCO_Terms__c,
                Payment_Terms__c, Bank_Name__c, Port_of_Loading__c, Port_of_Discharge__c,Account__r.Incoterms_Location_1__c,
                DESC_GOODS__c, Opportunity__c, PURCH_NO_S__c, Quote__c,PO_Number_unique__c, Account__r.CurrencyIsoCode,

                Exporter__Street__s, Exporter__City__s, Exporter__PostalCode__s,
                Exporter__StateCode__s, Exporter__CountryCode__s,
                Consignee__Street__s, Consignee__City__s, Consignee__PostalCode__s,
                Consignee__StateCode__s, Consignee__CountryCode__s, Quote__r.Opportunity.CloseDate,
                Opportunity__r.Pricebook2Id, Total_CIF__c, REMARKS__c,

                Final_Destination__c,Pricing_Type__c,IHC_Transport__c,Packing_Charges__c,
                Discount__c,SOC_Charges__c,Inspection_Charges__c,Insurance__c,Incoterms_Location__c
            FROM Purchase_Order__c
            WHERE Id IN :poIdList
        ];

        System.debug('Fetched Purchase Orders: ' + purchaseOrders.size());

        if (!purchaseOrders.isEmpty()) {
            Map<Id, List<Purchase_Order_Line_Item__c>> lineItemMap = new Map<Id, List<Purchase_Order_Line_Item__c>>();
            for (Purchase_Order_Line_Item__c line : [
                SELECT 
                Id, Purchase_Order__c, PURCH_NO_S__c, ITM_NUMBER__c, Material__c, TARGET_QTY__c,
                PLANT__c, ITEM_CATEG__c, REMARKS__c, SERIALNO__c, Priority__c, Quantity__c,
                Purchase_Order_Date__c, STORE_LOC__c, Product__r.Material_Code__c, Product__r.PLANT__c,
                Product__c, Product__r.ProductCode, PurcahseOrderProducts_External_ID__c,
                Product__r.RecordType.DeveloperName, Item_Description__c,Parent_POLI__c,Alternative_BOM__c,
                Alternate_Product_Model__c, Alternate_Product_Name__c
                FROM Purchase_Order_Line_Item__c
                WHERE Purchase_Order__c IN :poIdList
                AND Product__r.RecordType.DeveloperName != 'Alternate_BOM'
            ]) {
                if (!lineItemMap.containsKey(line.Purchase_Order__c)) {
                    lineItemMap.put(line.Purchase_Order__c, new List<Purchase_Order_Line_Item__c>());
                }
                lineItemMap.get(line.Purchase_Order__c).add(line);
            }

            System.debug('purchaseOrders size '+purchaseOrders.size()+'.  '+purchaseOrders);

            for (Purchase_Order__c po : purchaseOrders) {
                try {
                    List<Purchase_Order_Line_Item__c> lineItems = lineItemMap.get(po.Id);
                    System.debug(' Line Items : ' + lineItems);
                    System.debug(' Line Item Code : ' + lineItems[0].Product__r.ProductCode);
                    PurchaseOrderAPIRequestWrapper requestWrapper = new PurchaseOrderAPIRequestWrapper(po, lineItems);
                    System.debug('requestWrapper > '+requestWrapper);
                    String requestBody = generateOrderedJSON(requestWrapper);
                    System.debug('requestBody > '+requestBody);
                    String endpoint = getEndpointUrl('POToSOCreation');

                    HttpRequest request = new HttpRequest();
                    request.setTimeout(20000);
                    request.setMethod('POST');
                    request.setEndpoint(endpoint );
                    request.setHeader('Content-Type', 'application/json');
                    request.setHeader('Authorization', authHeader);
                    request.setBody(requestBody);

                    Http http = new Http();
                    HttpResponse response = http.send(request);
                    String responseBody = response.getBody();

                    System.debug('🔵 Raw SAP responseBody: ' + responseBody);
                    System.debug('🔵 Status Code: ' + response.getStatusCode());

                    SAPResponseWrapper sapResp;
                    try {
                        // Optional: fix any known field name issues
                        String cleanedResponseBody = responseBody.replace('"PO_Number ":', '"PO_Number":');
                        System.debug('🧼 Cleaned responseBody: ' + cleanedResponseBody);
                        cleanedResponseBody = cleanedResponseBody.replace('"SO_Line_Item_External_Id__c":', '"SO_Line_Item_External_Id":');
                        System.debug('🧼 Cleaned responseBody: ' + cleanedResponseBody);

                        sapResp = (SAPResponseWrapper) JSON.deserialize(cleanedResponseBody, SAPResponseWrapper.class);
                        System.debug('✅ Deserialized SAP Response: ' + sapResp);

                    } catch (Exception parseEx) {
                        resultMessage += '\n⚠️ Failed to parse SAP response for ' + po.Name + ': ' + parseEx.getMessage();
                        ErrorLogs.response(parseEx.getMessage(), responseBody, response.getStatusCode(), 'Parse Error', 'PurchaseOrderCallout');
                        continue;
                    }


                    String poNum = sapResp != null ? sapResp.PO_Number : 'N/A';
                    String soNum = sapResp != null ? sapResp.SO_Number : 'N/A';
                    String status = sapResp != null ? sapResp.Status : 'Unknown';
                    String reason = sapResp != null ? sapResp.Reason : 'No reason provided';

                    if (status == 'Success') {
                        resultMessage += '\n✅ Success for ' + po.Name + ' | SO: ' + soNum + ' | Reason: ' + reason;
                        // 🔁 Pass responseBody and PO_Items to the handler
                        PurchaseOrderResponseHandler.handleResponse(responseBody,sapResp, po); // modify this method to accept sapResp.PO_Items if needed
                        successPOs.add(po);
                    } else {
                        resultMessage += '\n❌ Failed for ' + po.Name + ' | PO: ' + poNum + ' | SO: ' + soNum + ' | Reason: ' + reason;
                        // resultMessage += '\n'+ po.Name + ' | PO: ' + poNum + ' | SO: ' + soNum + ' | Reason: ' + reason;
                        ErrorLogs.response(responseBody, requestBody, response.getStatusCode(), 'SAP Error', 'PurchaseOrderCallout');
                    }

                } catch (Exception e) {
                    resultMessage += '\n🚫 Exception for ' + po.Name + ': ' + e.getMessage();
                    ErrorLogs.response(e.getMessage(), '', -1, 'Exception', 'PurchaseOrderCallout');
                }
            }

            updateRelatedClaims(successPOs);
        }

        return resultMessage;
    }

    public static String getEndpointUrl(String apiName) {
        SAP_API_Endpoint__mdt endpointConfig = [
            SELECT Endpoint_URL__c 
            FROM SAP_API_Endpoint__mdt 
            WHERE DeveloperName = :apiName 
            LIMIT 1
        ];
        return endpointConfig.Endpoint_URL__c;
    }

    public static SAP_API_Endpoint__mdt getCredentials() {
        return [
            SELECT Username__c,Password__c
            FROM SAP_API_Endpoint__mdt 
            WHERE DeveloperName = 'Credentials' 
            LIMIT 1
        ];
    }
    

