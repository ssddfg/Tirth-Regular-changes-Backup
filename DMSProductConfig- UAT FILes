    paginateEndProducts() {
    if (!this.allEndProducts || this.allEndProducts.length === 0) {
        this.endProducts = [];
        return;
    }
    const start = (this.currentPage - 1) * this.pageSize;
    const end = start + this.pageSize;

    const paginatedSlice = this.allEndProducts.slice(start, end);

    const selectedIds = new Set(this.selectedProducts.map(p => p.productId));
    console.log('DEBUG: Paginating with selected IDs:', JSON.stringify(Array.from(selectedIds))); // <-- ADD THIS LINE

    this.endProducts = paginatedSlice.map(product => ({
        ...product,
        selected: selectedIds.has(product.id)
    }));
}


