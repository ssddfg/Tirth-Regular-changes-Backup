    }

    @isTest
    static void testBuildFallbackOrderItems() {
        List<Purchase_Order_Line_Item__c> poList = [
            SELECT Id, Product__c, Product__r.Name, TARGET_QTY__c, REMARKS__c, 
                   STORE_LOC__c, ITEM_CATEG__c, PLANT__c, SERIALNO__c, Purchase_Order_Date__c 
            FROM Purchase_Order_Line_Item__c
        ];

        // Only mark one PO Line Item as already mapped
        Set<Id> alreadyMapped = new Set<Id>{ poList[1].Id };

        Order so = [SELECT Id FROM Order ];

        Test.startTest();
        List<OrderItem> fallbackItems = SOFallbackItemHandler.buildFallbackOrderItems(so, poList, alreadyMapped);
        Test.stopTest();

        System.assertEquals(1, fallbackItems.size(), 'Only one fallback OrderItem should be created');

        OrderItem item = fallbackItems[0];
        
    }
}
