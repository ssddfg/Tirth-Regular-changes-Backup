            Exporter__CountryCode__s = 'IN',
            Consignee__Street__s = 'CStreet',
            Consignee__City__s = 'CCity',
            //Consignee__StateCode__s = 'CST',
            Consignee__PostalCode__s = '654321',
            Consignee__CountryCode__s = 'US',
            Buyer__c = 'Test Buyer',
