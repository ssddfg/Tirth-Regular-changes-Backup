groupProducts(rawData) {

    const objectType =
        this.recordId.substring(0, 3) === '006' ? 'Opportunity' : 'Quote';

    const grouped = [];
    const parentIdMap = {};

    // 1️⃣ Create parents
    rawData.forEach(item => {

        let isParent = false;

        if (objectType === 'Opportunity') {
            isParent = !item.Parent_Product__c;
        } else {
            isParent = !item.Parent_Quote_Line_Item__c;
        }

        if (isParent) {

            parentIdMap[item.Id] = {
                id: item.Id,
                productId: item.Product2Id,
                name: item.Product2?.Name,
                price: item.UnitPrice || 0,
                quantity: item.Quantity || 0,
                listPrice: item.ListPrice,
                rcPrice: item.RC_Price__c,
                imageUrl: item.Product2?.Product_Image__c,
                recordType: item.Product2?.RecordType?.Name,
                isParent: true,
                childGroups: [],
                showSelectBom: true,
                bomButtonLabel: 'Select ALT BOM',
                selectedAltBom: null
            };

            grouped.push(parentIdMap[item.Id]);
        }
    });


    // 2️⃣ Create child groups
    rawData.forEach(item => {

        let parentId = null;

        if (objectType === 'Opportunity') {
            parentId = item.Parent_Product__c;
        } else {
            parentId = item.Parent_Quote_Line_Item__c;
        }

        if (parentId && parentIdMap[parentId]) {

            const parent = parentIdMap[parentId];

            const bomGroupName =
                item.Product2?.Alternative_BOM__c || 'BOM Group';

            let group =
                parent.childGroups.find(g => g.groupName === bomGroupName);

            if (!group) {

                group = {
                    groupName: bomGroupName,
                    groupUiKey: parentId + '_' + bomGroupName,
                    parentLineItemId: parentId,
                    items: []
                };

                parent.childGroups.push(group);
            }

            // ✅ ADD CHILD
            group.items.push(item);
        }
    });


    // 3️⃣ Set selected ALT BOM
    grouped.forEach(parent => {

        if (parent.childGroups.length > 0) {

            const firstGroup = parent.childGroups[0];

            if (firstGroup.items.length > 0) {

                parent.selectedAltBom =
                    firstGroup.items[0].Product2?.Alternative_BOM__c;
            }

            parent.bomButtonLabel = 'Change ALT BOM';
        }
    });

    this.groupedProducts = grouped;
}


