    // 🔍 Auto-populate fields from Serial Number (Asset + Equipment)
    private static void assignDetailsFromSerialNumber(List<Case> caseList) {
        Set<String> serialNumbers = new Set<String>();
        for (Case c : caseList) {
            if (String.isNotBlank(c.Machine_Serial_No__c)) {
                serialNumbers.add(c.Machine_Serial_No__c.trim());
            }
        }

        System.debug('🔍 Serial numbers collected: ' + serialNumbers);

        Map<String, Asset> serialToAssetMap = new Map<String, Asset>();
        Map<String, Equipment_Data__c> serialToEquipmentMap = new Map<String, Equipment_Data__c>();

        if (!serialNumbers.isEmpty()) {
            for (Asset a : [
                SELECT Id, SerialNumber, Product2Id, Product2.Name , AccountId,
                       Product2.Product_Model__c, Product2.Material_Code__c,
                       Product2.RecordType.Name
                FROM Asset
                WHERE SerialNumber IN :serialNumbers
            ]) {
                serialToAssetMap.put(a.SerialNumber, a);
                System.debug('🔗 Asset found: ' + a.SerialNumber + ' → ' + a.Id);
            }

            List<Equipment_Data__c> equipmentList = [
                SELECT Id, Material_Serial_Number__c,
                       Invoice_Line_Item__r.Invoice__r.Order__r.OrderNumber,
                       Invoice_Line_Item__r.Invoice__r.Invoice_ExternalID__c,
                       Invoice_Line_Item__r.Invoice__c
                FROM Equipment_Data__c
                WHERE Material_Serial_Number__c IN :serialNumbers
            ];

            for (Equipment_Data__c ed : equipmentList) {
                serialToEquipmentMap.put(ed.Material_Serial_Number__c, ed);
                System.debug('🔗 Equipment found: ' + ed.Material_Serial_Number__c + ' → ' + ed.Id);
            }
        }

        for (Case c : caseList) {
            String sn = String.isNotBlank(c.Machine_Serial_No__c) ? c.Machine_Serial_No__c.trim() : null;

            if (sn != null && serialToAssetMap.containsKey(sn)) {
                Asset a = serialToAssetMap.get(sn);
                Equipment_Data__c ed = serialToEquipmentMap.get(sn);

                c.AssetId = a.Id;
                c.Product__c = a.Product2.Name;

                System.debug('✅ Mapped AssetId: ' + a.Id + ', Product__c: ' + a.Product2Id);

                if (a.Product2Id != null) {
                    String rtName = a.Product2.RecordType.Name;
                    if (rtName == 'Material (Finished Product)') {
                        c.Model__c = a.Product2.Product_Model__c;
                    } else if (rtName == 'Spares') {
                        c.Model__c = a.Product2.Material_Code__c;
                    }
                    System.debug('📦 Product RecordType: ' + rtName + ', Model__c: ' + c.Model__c);
                }

                if (c.AccountId == null) {
                    c.AccountId = a.AccountId;
                    System.debug('👥 Set AccountId: ' + a.AccountId);
                }

                if (ed != null) {
                    if (ed.Invoice_Line_Item__r?.Invoice__r?.Order__r != null) {
                        String orderNumberStr = ed.Invoice_Line_Item__r.Invoice__r.Order__r.OrderNumber;
                        System.debug('🔎 Raw OrderNumber: ' + orderNumberStr);
                        if (String.isNotBlank(orderNumberStr)) {
                            try {
                                //c.Order_No__c = Decimal.valueOf(orderNumberStr);

								 c.Order_No__c = orderNumberStr;							

                                System.debug('✅ Set Order_No__c: ' + c.Order_No__c);
                            } catch (Exception ex) {
                                System.debug('⚠️ Error parsing OrderNumber: ' + orderNumberStr);
                            }
                        }
                    }

                    if (ed.Invoice_Line_Item__r?.Invoice__r != null) {
                        String extIdStr = ed.Invoice_Line_Item__r.Invoice__r.Invoice_ExternalID__c;
                        System.debug('🔎 Raw Invoice External ID: ' + extIdStr);
                        if (String.isNotBlank(extIdStr)) {
                            try {
                                c.Invoice_No__c = extIdStr;
                                System.debug('✅ Set Invoice_No__c: ' + c.Invoice_No__c);
                            } catch (Exception ex) {
                                System.debug('⚠️ Could not parse Invoice_ExternalID__c: ' + extIdStr);
                            }
                        }
                    }
                }
                System.debug('✅ Case Before Insertion: ' + c);
            } else {
                System.debug('❌ No matching Asset found for Serial Number: ' + sn);
            }
        }
    }

    
    

