public class CaseTriggerHandler extends TriggerHandler {
    private List<Case> newRecords;
    private List<Case> oldRecords;
    private Map<Id, Case> newRecordsMap;
    private Map<Id, Case> oldRecordsMap;

    public CaseTriggerHandler() {
        super('CaseTriggerHandler');
        this.newRecords = (List<Case>) Trigger.new;
        this.oldRecords = (List<Case>) Trigger.old;
        this.newRecordsMap = (Map<Id, Case>) Trigger.newMap;
        this.oldRecordsMap = (Map<Id, Case>) Trigger.oldMap;
    }

    public override void beforeInsert() {
        System.debug('🚀 Trigger BEFORE INSERT fired');
        setReportedByUser(newRecords);
        assignTCRDateAndSequence(newRecords);
        assignDetailsFromSerialNumber(newRecords);
        CaseAssignmentRules.assignToServiceManager(newRecords); // adding here - Nathan - 24/07/25
		setDateOfRetailFromAsset(newRecords);

       

		
    }

	public override void beforeUpdate() 
    {
    	setDateOfRetailFromAsset(newRecords);

		
		
	}
	

    public override void afterInsert() {
        System.debug('✅ Trigger AFTER INSERT fired');
        assignCaseAssignmentRule(newRecords);
        CaseAssignmentRules.shareCaseWithCreator(newRecords);

        //TCR Number Search
    	if(!isTCRSearchUpdated)
        {
        	isTCRSearchUpdated = true;
        	updateTCRSearchField(newRecords);
    	}
    }

	public override void afterUpdate() {
         //TCR Number Search
    if(!isTCRSearchUpdated){
        isTCRSearchUpdated = true;
        updateTCRSearchField(newRecords);
    }
	}

    // 👤 Auto-set Reported By
    private static void setReportedByUser(List<Case> caseList) {
        for (Case c : caseList) {
            if (c.Reported_By__c == null) {
                c.Reported_By__c = UserInfo.getUserId();
                System.debug('👤 Set Reported_By__c: ' + c.Reported_By__c);
            }
        }
    }

    // 🔁 Assign using Case Assignment Rule (for portal users)
    private static void assignCaseAssignmentRule(List<Case> newList) {
        User currentUser = [
            SELECT Id, IsPortalEnabled
            FROM User
            WHERE Id = :UserInfo.getUserId()
            LIMIT 1
        ];

        System.debug('🧑‍💻 IsPortalEnabled: ' + currentUser.IsPortalEnabled);

        if (currentUser.IsPortalEnabled || Test.isRunningTest()) {
            List<Case> listUpdateCase = new List<Case>();

            for (Case caseRec : newList) {
                if (caseRec.Id != null) {
                    Case updateCase = new Case(Id = caseRec.Id);

                    Database.DMLOptions dmlOpts = new Database.DMLOptions();
                    dmlOpts.assignmentRuleHeader.useDefaultRule = true;

                    updateCase.setOptions(dmlOpts);
                    listUpdateCase.add(updateCase);

                    System.debug('📤 Adding case for assignment rule update: ' + caseRec.Id);
                }
            }

            if (!listUpdateCase.isEmpty()) {
                Database.update(listUpdateCase);
                System.debug('✅ Updated cases with assignment rule.');
            }
        }
    }

