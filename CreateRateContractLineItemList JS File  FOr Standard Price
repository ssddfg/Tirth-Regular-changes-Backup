import { LightningElement, api, track, wire } from 'lwc';
import getProductPrice from '@salesforce/apex/CreateRateContractLineItemController.getProductPrice';
import createRateContractLineItems from '@salesforce/apex/CreateRateContractLineItemController.createRateContractLineItems';
import searchProducts from '@salesforce/apex/CreateRateContractLineItemController.searchProducts';
import { CloseActionScreenEvent } from 'lightning/actions';
import { ShowToastEvent } from 'lightning/platformShowToastEvent';
import { getObjectInfo } from 'lightning/uiObjectInfoApi';
import { getPicklistValues } from 'lightning/uiObjectInfoApi';
import { getRecord } from 'lightning/uiRecordApi';
import PRODUCT_CODE_FIELD from '@salesforce/schema/Product2.ProductCode';
import getProductDetails from '@salesforce/apex/CreateRateContractLineItemListController.getProductDetails';
import isDuplicateProduct from '@salesforce/apex/CreateRateContractLineItemController.isDuplicateProduct';
import { NavigationMixin } from 'lightning/navigation';
import { refreshApex } from '@salesforce/apex';


import { getRecordNotifyChange } from 'lightning/uiRecordApi';

import RATE_CONTRACT_LINE_ITEM_OBJECT from '@salesforce/schema/Rate_Contract_Line_Item__c';
import INCO_TERMS_FIELD from '@salesforce/schema/Rate_Contract_Line_Item__c.INCO_Terms__c';

import RATE_CONTRACT_CURRENCY_FIELD from '@salesforce/schema/Rate_Contract__c.CurrencyIsoCode';



export default class CreateRateContractLineItemList extends NavigationMixin(LightningElement) {

    @api recordId;
    @track incoTermsOptions = [];
    items = [];
    nextId = 1;
    currencyValue = '';
    incoTerm = '';

    displayInfo = {
    primaryField: 'Name',
    additionalFields: ['ProductCode']
};
    
    
    matchingInfo = {
        primaryField: { fieldPath: 'ProductCode', mode: 'contains' }
        // additionalFields: [{ fieldPath: 'ProductCode', mode: 'contains' }],
    };

    // handleProductChange(event) {
    //     const recordId = event.detail.value;
    //     const field = event.target.dataset.field;
    //     const itemId = event.target.dataset.id;

    //     console.log('Selected Product ID:', recordId);
    //     console.log('Field:', field);
    //     console.log('Item ID:', itemId);

    //     // Implement your logic to handle the selected product
    // }

    @wire(getRecord, { recordId: '$recordId', fields: [RATE_CONTRACT_CURRENCY_FIELD] })
    wiredRateContract({ error, data }) {
        if (data) {
            this.currencyValue = data.fields.CurrencyIsoCode.value;
            this.addItem();
        } else if (error) {
            console.error('Error fetching rate contract currency', error);
        }
    }

    renderedCallback() {
        const modalContainer = document.querySelector('.slds-modal__container');
        if (modalContainer && !modalContainer.classList.contains('custom-width')) {
            modalContainer.style.width = '80%';
            modalContainer.style.maxWidth = '1500px';
            modalContainer.style.minWidth = '480px';
            modalContainer.classList.add('custom-width');
        }
    }

    get productFilter() {
    return {
        criteria: [
            {
                fieldPath: 'Has_Alternative_BOM__c',
                operator: 'eq',
                value: false
            }
        ]
    };
}




    get isSaveDisabled() {
        return this.items.length === 0 || this.items.some(item => !item.product);
    }

    @wire(getObjectInfo, { objectApiName: RATE_CONTRACT_LINE_ITEM_OBJECT })
    objectInfo;

    @wire(getPicklistValues, { fieldApiName: INCO_TERMS_FIELD, recordTypeId: '$objectInfo.data.defaultRecordTypeId' })
    wiredPicklist({ error, data }) {
        if (data) {
            this.incoTermsOptions = data.values.map(item => ({ label: item.label, value: item.value }));
        } else if (error) {
            console.error('Error fetching picklist values:', error);
        }
    }

    handleFieldChange(event) {
        const fieldName = event.target.fieldName;
        const value = event.target.value;
        if (fieldName === 'Product__c' && value) {
            getProductPrice({ productId: value, rateContractId: this.recordId })
                .then(price => {
                    this.ndpExWorks = price;
                })
                .catch(error => {
                    this.dispatchEvent(
                        new ShowToastEvent({
                            title: 'Error',
                            message: 'Failed to fetch product price.',
                            variant: 'error'
                        })
                    );
                    console.error('Error fetching price:', error);
                });
        } else if (fieldName === 'Product__c' && !value) {
            this.ndpExWorks = null;
        }
    }

    handleProductSelect(event) {
        const itemId = event.target.dataset.id;
        const selectedProductId = event.detail.recordId;
        const selectedProductName = event.detail.recordName;

        // Update your row data accordingly
        this.items = this.items.map(row => {
            if (row.id === itemId) {
                return { ...row, selectedProductId, selectedProductName };
            }
            return row;
        });
    }

    addItem() {
        this.items = [
            ...this.items,
            {
                id: this.nextId++,
                product: '',
                productCode: '',
                ndpExWorks: this.ndpExWorks,
                actualPrice: '',
                rateContract: this.recordId,
                offerPriceINCO: '',
                incoTerms: '',
                currencyIsoCode: this.currencyValue,
                // Add these new keys
                searchKey: '',
                productResults: []
            }
        ];
    }


    removeItem(event) {
        const itemId = parseInt(event.target.dataset.id, 10);
        this.items = this.items.filter(item => item.id !== itemId);
    }


   isProductAlreadySelected(productId, currentItemId) {
    return this.items.some(
        item => item.product === productId && item.id !== currentItemId
    );
}


    handleInputChange(event) {
        const itemId = parseInt(event.target.dataset.id, 10);
        const field = event.target.dataset.field;
        let value = event.target.value;
        
         // Clear Offer Price error as soon as user enters value
    if (field === 'offerPriceINCO') {
        if (value) {
            event.target.setCustomValidity('');
        }
        event.target.reportValidity();
    }


        if (field === 'product') {
    value = event.detail.recordId;

    if (this.isProductAlreadySelected(value, itemId)) {
        this.dispatchEvent(
            new ShowToastEvent({
                title: 'Duplicate Product',
                message: 'Duplicate Product found. Please select a different product.',
                variant: 'error'
            })
        );
        return;
    }

    // Check duplicate in backend
    isDuplicateProduct({ rateContractId: this.recordId, productId: value })
        .then(isDuplicate => {
            if (isDuplicate) {
                this.dispatchEvent(
                    new ShowToastEvent({
                        title: 'Duplicate Product',
                        message: 'This product already exists in this Rate Contract.',
                        variant: 'error'
                    })
                );
                // Clear the selection
                this.items = this.items.map(item => {
                    if (item.id === itemId) {
                        return { ...item, product: '', productCode: '' };
                    }
                    return item;
                });
            } else {
                // If not duplicate, fetch product details
                getProductDetails({ productId: value, rateContractId: this.recordId })
                    .then(res => {
                        this.items = this.items.map(item => {
                            if (item.id === itemId) {
                                return {
                                    ...item,
                                    product: value,
                                    productCode: res.productCode,
                                    ndpExWorks: res.unitPrice,
                                    actualPrice: res.unitPrice
                                };
                            }
                            return item;
                        });
                    })
                    .catch(error => {
                        console.error(error);
                        this.dispatchEvent(
                            new ShowToastEvent({
                                title: 'Error',
                                message: 'Failed to fetch product details',
                                variant: 'error'
                            })
                        );
                    });
            }
        })
        .catch(error => {
            console.error(error);
        });


    if (value) {
        getProductDetails({
            productId: value,
            rateContractId: this.recordId
        })
        .then(res => {
            this.items = this.items.map(item => {
                if (item.id === itemId) {
                    return {
                        ...item,
                        product: value,
                        productCode: res.productCode, 
                        ndpExWorks: res.unitPrice,
                        actualPrice: res.unitPrice
                    };
                }
                return item;
            });
        })
        .catch(error => {
            console.error(error);
            this.dispatchEvent(
                new ShowToastEvent({
                    title: 'Error',
                    message: 'Failed to fetch product details',
                    variant: 'error'
                })
            );
        });
    }
}
else {
            this.items = this.items.map(item => {
                if (item.id === itemId) {
                    return { ...item, [field]: value };
                }
                return item;
            });
        }
    }

    get hasDuplicateProducts() {
    const products = this.items.map(i => i.product).filter(Boolean);
    return new Set(products).size !== products.length;
}

    save() {

        let isValid = true;

    // 🔴 Sirf Offer Price inputs validate honge
    const offerInputs = this.template.querySelectorAll(
        'lightning-input[data-field="offerPriceINCO"]'
    );

    offerInputs.forEach(input => {
        if (!input.value) {
            input.setCustomValidity('Offer Price is required');
            isValid = false;
        } else {
            input.setCustomValidity('');
        }
        input.reportValidity();
    });

    if (!isValid) {
        return; // ❌ stop save if any offer price is blank
    }

        const formattedItems = this.items.map(item => ({
            id: item.id,
            product: item.product,
            ndpExWorks: item.ndpExWorks === '' ? null : Number(item.ndpExWorks),
            actualPrice: item.actualPrice === '' ? null : Number(item.actualPrice),
            rateContract: item.rateContract,
            offerPriceINCO: item.offerPriceINCO === '' ? null : Number(item.offerPriceINCO),
            incoTerms: item.incoTerms,
            CurrencyIsoCode: item.currencyIsoCode 
        }));

        createRateContractLineItems({
            rateContractId: this.recordId,
            items: formattedItems
        })
            .then(() => {
                this.dispatchEvent(
                    new ShowToastEvent({
                        title: 'Success',
                        message: 'Rate Contract Line Items created successfully',
                        variant: 'success'
                    })
                );

                
                this.dispatchEvent(new CloseActionScreenEvent());
                


this[NavigationMixin.Navigate]({
    type: 'standard__recordPage',
    attributes: {
        recordId: this.recordId,
        objectApiName: 'Rate_Contract__c',
        actionName: 'view'
    }
}, true);


setTimeout(() => {
    location.reload();
}, 500); 

                
             

             })
            .catch(error => {
                this.dispatchEvent(
                    new ShowToastEvent({
                        title: 'Error',
                        message: error.body ? error.body.message : error.message,
                        variant: 'error'
                    })
                );
                console.error('Error saving:', error);
            });
            
    }

    cancel() {
        this.items = [];
        this.nextId = 1;
        this.addItem();
        this.dispatchEvent(new CloseActionScreenEvent());
    }

    // Custom search method for lightning-record-picker
    searchProducts = searchProducts;

    handleProductSearch(event) {
        const rowId = event.target.dataset.id;
        const searchKey = event.target.value;

        this.items = this.items.map(item => {
            if (item.id === Number(rowId)) {
                item.searchKey = searchKey;

                if (searchKey.length > 1) {
                    searchProducts({ searchTerm: searchKey })
                        .then(result => {
                            item.productResults = result.map(prod => ({
                                label: prod.Name,
                                value: prod.Id,
                                description: prod.ProductCode
                            }));
                            this.items = [...this.items];
                        })
                        .catch(error => console.error(error));
                } else {
                    item.productResults = [];
                }
            }
            return item;
        });
    }

    handleProductSelect(event) {
        const rowId = Number(event.currentTarget.dataset.itemid);
        const productId = event.currentTarget.dataset.id;

        this.items = this.items.map(item => {
            if (item.id === rowId) {
                const selected = item.productResults.find(prod => prod.value === productId);
                if (selected) {
                    item.searchKey = selected.label;
                    item.product = productId;
                    item.productResults = [];
                }
            }
            return item;
        });

        // Fetch product price and update that row
        getProductPrice({ productId: productId, rateContractId: this.recordId })
            .then(price => {
                this.items = this.items.map(item => {
                    if (item.id === rowId) {
                        return {
                            ...item,
                            ndpExWorks: price,
                            actualPrice: price,
                            //offerPriceINCO: price
                        };
                    }
                    return item;
                });
            })
            .catch(error => {
                console.error('Error fetching product price:', error);
                this.dispatchEvent(
                    new ShowToastEvent({
                        title: 'Error',
                        message: 'Failed to fetch product price.',
                        variant: 'error'
                    })
                );
            });
    }

    handleProductSelection(rowId, productId) {
        console.log('Selected Product:', productId, 'Row:', rowId);
    }


}
