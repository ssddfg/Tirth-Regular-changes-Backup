    @AuraEnabled
    public static String checkMandatoryPOLineItemFields(String poId) {
        if (String.isBlank(poId)) return 'Invalid Purchase Order ID.';

        List<Purchase_Order_Line_Item__c> lineItems = [
            SELECT Id, PLANT__c, STORE_LOC__c, Product__r.RecordType.Name, Product__r.Name
            FROM Purchase_Order_Line_Item__c
            WHERE Purchase_Order__c = :poId
            AND Product__r.RecordType.Name IN ('Spares', 'Material (Finished Product)')
        ];

        if (lineItems.isEmpty()) {
            return 'No matching line items found for the given Purchase Order.';
        }

        Map<String, Set<String>> productMissingFieldMap = new Map<String, Set<String>>();

        for (Purchase_Order_Line_Item__c item : lineItems) {
            Set<String> missingFields = new Set<String>();
            
            if (String.isBlank(item.PLANT__c)) {
                missingFields.add('Plant');
            }
            if (String.isBlank(item.STORE_LOC__c)) {
                missingFields.add('Storage Location');
            }

            if (!missingFields.isEmpty()) {
                String productName = item.Product__r != null ? item.Product__r.Name : 'Unknown Product';
                if (!productMissingFieldMap.containsKey(productName)) {
                    productMissingFieldMap.put(productName, new Set<String>());
                }
                productMissingFieldMap.get(productName).addAll(missingFields);
            }
        }

        if (!productMissingFieldMap.isEmpty()) {
            List<String> errorMessages = new List<String>();
            for (String product : productMissingFieldMap.keySet()) {
                errorMessages.add('Product: ' + product + ' → Missing: ' + String.join(new List<String>(productMissingFieldMap.get(product)), ', '));
            }
            return 'Missing required fields:\n' + String.join(errorMessages, '\n');
        }

        return ''; // All fields are filled
    }



    public static String generateOrderedJSON(PurchaseOrderAPIRequestWrapper wrapper) {
        JSONGenerator gen = JSON.createGenerator(true);

        gen.writeStartObject();
        gen.writeStringField('PURC_ORDER', wrapper.PURC_ORDER);
        gen.writeStringField('CUST_PONO', wrapper.CUST_PONO);
        gen.writeStringField('DOC_TYPE', wrapper.DOC_TYPE);
        gen.writeStringField('SALES_ORG', wrapper.SALES_ORG);
        gen.writeStringField('DISTR_CHAN', wrapper.DISTR_CHAN);
        gen.writeStringField('DIVISION', wrapper.DIVISION);
        gen.writeStringField('REQ_DATE_H', wrapper.REQ_DATE_H);
        gen.writeStringField('SALES_OFF', wrapper.SALES_OFF);
        gen.writeStringField('SALES_GRP', wrapper.SALES_GRP);
        gen.writeStringField('SHIP_TYPE', wrapper.SHIP_TYPE);
        gen.writeStringField('INCO_VERSION', wrapper.INCO_VERSION);
        gen.writeStringField('INCO_TERMS', wrapper.INCO_TERMS);
        gen.writeStringField('PAYM_TERMS', wrapper.PAYM_TERMS);
        gen.writeStringField('BANK_NAME', wrapper.BANK_NAME);
        gen.writeStringField('PORT_LOADING', wrapper.PORT_LOADING);
        gen.writeStringField('PORT_DISCHARGE', wrapper.PORT_DISCHARGE);
        gen.writeStringField('DESC_GOODS', wrapper.DESC_GOODS);
        gen.writeStringField('PURCH_NO_C', wrapper.PURCH_NO_C);
        gen.writeStringField('PURCH_DATE', wrapper.PURCH_DATE);
        gen.writeStringField('PARTN_NUMB', wrapper.PARTN_NUMB);
        gen.writeStringField('PARTN_NUMB1', wrapper.PARTN_NUMB1);

        gen.writeStringField('FINAL_DESTINATION', String.valueOf(wrapper.FINAL_DESTINATION));
        gen.writeStringField('PRICING_TYPE', String.valueOf(wrapper.PRICING_TYPE));
        gen.writeStringField('IHC_TRANSPORT', String.valueOf(wrapper.IHC_TRANSPORT));
        gen.writeStringField('PACKING_CHARGES', String.valueOf(wrapper.PACKING_CHARGES));
        gen.writeStringField('DISCOUNT', String.valueOf(wrapper.DISCOUNT));
        gen.writeStringField('SOC_CHARGES', String.valueOf(wrapper.SOC_CHARGES));
        gen.writeStringField('INSPECTION_CHARGES', String.valueOf(wrapper.INSPECTION_CHARGES));
        gen.writeStringField('INSURANCE_CHARGES', String.valueOf(wrapper.INSURANCE_CHARGES));
gen.writeStringField('INCO_LOCATION', String.valueOf(wrapper.INCO_LOCATION));

        gen.writeFieldName('PO_Items');
        gen.writeStartArray();
        for (PurchaseOrderAPIRequestWrapper.PurchaseOrderLineItemWrapper item : wrapper.PO_Items) {
            gen.writeStartObject();
            gen.writeStringField('MATERIAL', item.MATERIAL);
            gen.writeStringField('TARGET_QTY', item.TARGET_QTY);
            gen.writeStringField('PLANT', item.PLANT);
            gen.writeStringField('ITEM_CATEG', item.ITEM_CATEG);
            gen.writeStringField('REMARKS', item.REMARKS);
            gen.writeStringField('SERIALNO', item.SERIALNO);
            gen.writeStringField('PRIORITY', item.PRIORITY);
            gen.writeStringField('PURCH_NO_S', item.PURCH_NO_S);
            gen.writeStringField('PO_DAT_S', item.PO_DAT_S);
            gen.writeStringField('STLAL', item.STLAL);
            gen.writeStringField('STORE_LOC', item.STORE_LOC);
            gen.writeStringField('ALTERNATE_PRODUCT_NAME', item.ALTERNATE_PRODUCT_NAME);
            gen.writeStringField('ALTERNATE_PRODUCT_MODEL', item.ALTERNATE_PRODUCT_MODEL);
            gen.writeEndObject();
        }
        gen.writeEndArray();

        gen.writeEndObject();
        return gen.getAsString();
    }

    public static String decodeNumericHtmlEntities(String input) {
        String result = input;
        Pattern pattern = Pattern.compile('&#(\\d+);');
        Matcher matcher = pattern.matcher(result);

        Set<String> matchedEntities = new Set<String>();

        while (matcher.find()) {
            String fullMatch = matcher.group(0); // e.g., "&#124;"
            String codeStr = matcher.group(1);   // e.g., "124"

            if (!matchedEntities.contains(fullMatch)) {
                matchedEntities.add(fullMatch);

                Integer code = Integer.valueOf(codeStr);

                // Convert integer to char using char array
                List<Integer> codeList = new List<Integer>{ code };
                String replacement = String.fromCharArray(codeList);

                result = result.replace(fullMatch, replacement);
            }
        }
        return result;
    }

    
    public static void updateRelatedClaims(List<Purchase_Order__c> successPOs){ 
        System.debug('successPOs: '+successPOs);

        if (successPOs == null || successPOs.isEmpty()) {
            System.debug('No successful POs passed for claim update.');
            return;
        }

        List<Warranty_Claim__c> relatedClaims = [SELECT Id, Claim_Status__c, Purchase_Order__c FROM Warranty_Claim__c WHERE Purchase_Order__c IN :new Map<Id, Purchase_Order__c>(successPOs).keySet()];

        System.debug('relatedClaims: '+relatedClaims);
        List<Warranty_Claim__c> claimsToUpdate = new List<Warranty_Claim__c>();
        for(Warranty_Claim__c wc : relatedClaims){
            if(wc.Claim_Status__c == 'Open'){
                wc.Claim_Status__c = 'Synced TO SAP';
                claimsToUpdate.add(wc);
            }
        }

        System.debug('claimsToUpdate size : '+claimsToUpdate.size());

        if(!claimsToUpdate.isEmpty()){
            try{
                update claimsToUpdate;
            }catch(Exception e){
                System.debug('Error occurred while updating related claims. Error: '+e);
            }
        }
    }
