                                                                <template if:true={product.bomGroupSummaries}>
                                    <template for:each={product.bomGroupSummaries} for:item="bomSummary">
                                        <tr key={bomSummary.groupKey} class="alt-bom-row">
                                            <td></td>
                                            <td colspan="11">
                                                <div class="clickable-link" data-id={bomSummary.Id}
                                                    onclick={handleNavigate} title="Click to view product">
                                                    <span class="link-content">
                                                        <lightning-icon icon-name="utility:chevronright" size="xx-small"
                                                            alternative-text="Go" title="Go"></lightning-icon>
