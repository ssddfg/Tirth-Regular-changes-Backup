        @AuraEnabled(cacheable=true)
    public static Id getPricebookIdByCurrency(String currencyCode) {
        if (String.isBlank(currencyCode)) {
            return null;
        }
        // Find the first active pricebook that matches the currency.
        // You might have multiple, so LIMIT 1 gets the first one found.
        List<Pricebook2> pricebooks = [
            SELECT Id
            FROM Pricebook2
            WHERE CurrencyIsoCode = :currencyCode AND IsActive = true
            LIMIT 1
        ];

        if (!pricebooks.isEmpty()) {
            return pricebooks[0].Id;
        }
        // Return null if no active pricebook is found for that currency
        return null;
    }



