handleProductSelection(event) {
    const { productId, selected } = event.detail;
    if (!productId) {
        console.error('Product ID is missing from the selection event.');
        return;
    }

    // --- Part 1: Find the full product data from the component's current state ---

    // Determine which list is currently visible on screen
    const visibleList = this.isProdGroupSelected ? this.endProducts : this.visibleProducts;
    
    // Find the complete product object from that list using the ID from the event
    const fullProduct = visibleList.find(p => p.id === productId || p.Id === productId);

    if (!fullProduct) {
        console.error('Could not find the selected product in the visible list.');
        return;
    }


    // --- Part 2: Update the master `selectedProducts` list for the cart ---

    if (selected) {
        if (!this.selectedProducts.some(p => p.productId === productId)) {
            
            // Create the new object for the cart using our complete 'fullProduct' object
            const newSelectedProduct = {
                // Base details can come from the event
                ...event.detail,

                // ✅ FINAL FIX: Get the BOM data from the full product object, not the event
                bomList: fullProduct.childProducts || [], 

                // Add filter values and ensure productId is set
                ...this.selectedFilterValues,
                productId: fullProduct.id || fullProduct.Id
            };
            
            // Add the clean, normalized product to the master list
            this.selectedProducts = [...this.selectedProducts, newSelectedProduct];
        }
    } else {
        // This part for de-selection is correct
        this.selectedProducts = this.selectedProducts.filter(p => p.productId !== productId);
    }


    // --- Part 3: Update the UI to show the checkmark (this logic is correct) ---

    fullProduct.selected = selected; // Update the object in the visible list

    // Trigger a refresh of the visible list
    if (this.isProdGroupSelected) {
        this.endProducts = [...this.endProducts];
    } else {
        this.visibleProducts = [...this.visibleProducts];
    }
}


