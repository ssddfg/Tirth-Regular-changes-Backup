public class SOFallbackItemHandler {
    /**
     * Creates fallback OrderItems for PO Line Items that weren't mapped earlier.
     * @param so - The Sales Order record
     * @param poLineItems - All PO Line Items
     * @param alreadyMappedItemIds - Set of PO Line Item IDs already used
     * @return List of fallback OrderItems
     */
    public static List<OrderItem> buildFallbackOrderItems(
        Order so,
        List<Purchase_Order_Line_Item__c> poLineItems,
        Set<Id> alreadyMappedItemIds
    ) {
        List<OrderItem> fallbackItems = new List<OrderItem>();

        for (Purchase_Order_Line_Item__c poItem : poLineItems) {
            if (alreadyMappedItemIds.contains(poItem.Id)) {
                continue; // Skip already mapped
            }

            if (poItem.Product__r == null || poItem.Product__c == null) {
                System.debug('⚠️ Fallback skipped: Product__c missing for PO Line Item ' + poItem.Id);
                continue;
            }

            List<PricebookEntry> pricebookEntries = [
                SELECT Id FROM PricebookEntry 
                WHERE Product2Id = :poItem.Product__c AND IsActive = true 
                LIMIT 1
            ];

            if (pricebookEntries.isEmpty()) {
                System.debug('⚠️ Fallback skipped: No active PricebookEntry for product ' + poItem.Product__c);
                continue;
            }

            OrderItem soi = new OrderItem();
            soi.OrderId = so.Id;
            soi.Product2Id = poItem.Product__c;
            soi.PricebookEntryId = pricebookEntries[0].Id;
            soi.Quantity = poItem.TARGET_QTY__c != null ? poItem.TARGET_QTY__c : 1;
            soi.UnitPrice = 0;
            soi.Description = poItem.REMARKS__c;
            soi.Status__c = 'Draft';
            soi.STORE_LOC__c = poItem.STORE_LOC__c;
            soi.ITEM_CATEG__c = poItem.ITEM_CATEG__c;
            soi.PLANT__c = poItem.PLANT__c;
            soi.Machine_Serial_No__c = poItem.SERIALNO__c;
            soi.ServiceDate = poItem.Purchase_Order_Date__c;
            soi.SO_Line_Item_External_Id__c = null;

            fallbackItems.add(soi);
            System.debug('✅ Fallback OrderItem prepared for PO Line Item: ' + poItem.Id);
        }

        return fallbackItems;
    }
}


