private static void assignTCRDateAndSequence(List<Case> caseList) {
    Date today = Date.today();
    Integer sequence = 0;

    // 🔎 Get RecordType Id of TCR
    Id tcrRtId = Schema.SObjectType.Case.getRecordTypeInfosByName().get('TCR').getRecordTypeId();
    System.debug('🎯 TCR RecordTypeId: ' + tcrRtId);

    // 🗓️ STEP 1: Determine current Financial Year start date (April 1)
    Integer currentYear = today.year();
    Date fyStart;
    if (today.month() < 4) {
        // Before April → financial year started last year
        fyStart = Date.newInstance(currentYear - 1, 4, 1);
    } else {
        // April or later → financial year started this year
        fyStart = Date.newInstance(currentYear, 4, 1);
    }
    System.debug('📅 Current Financial Year Start: ' + fyStart);

    // 1️⃣ Query MAX sequence only for current FY (and TCR record type)
    AggregateResult[] ar = [
        SELECT MAX(TCR_Sequence__c) maxSeq
        FROM Case
        WHERE RecordTypeId = :tcrRtId
        AND TCR_Date__c >= :fyStart
    ];
    System.debug('📊 AggregateResult (MAX sequence for FY): ' + ar);

    // 2️⃣ Use max value if found, else start fresh from 0
    if (!ar.isEmpty() && ar[0].get('maxSeq') != null) {
        sequence = ((Decimal) ar[0].get('maxSeq')).intValue();
        System.debug('🔢 Current MAX sequence found in this FY: ' + sequence);

        // 3️⃣ Lock the record that holds the current MAX sequence (only TCR cases in this FY)
        List<Case> lockRow = [
            SELECT Id, TCR_Sequence__c
            FROM Case
            WHERE RecordTypeId = :tcrRtId
              AND TCR_Sequence__c = :sequence
              AND TCR_Date__c >= :fyStart
            LIMIT 1
            FOR UPDATE
        ];
        System.debug('🔒 Locked row: ' + lockRow);
    } else {
        System.debug('⚠️ No TCR records found for current FY. Starting sequence = 0');
    }

    // 4️⃣ Assign new sequence numbers only for TCR cases
    for (Case c : caseList) {
        if (c.RecordTypeId == tcrRtId) {
            sequence = sequence + 1;
            c.TCR_Date__c = today;
            c.TCR_Sequence__c = sequence;
            System.debug('✅ Assigned -> CaseId: ' + c.Id 
                       + ' | Date: ' + today 
                       + ' | Sequence: ' + sequence);
        } else {
            System.debug('⏭️ Skipped (Helpdesk record): ' + c.Id);
        }
    }
}



