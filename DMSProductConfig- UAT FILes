        // console.log('Visible Products (after slicing):', JSON.stringify(this.endProducts));

                        let filteredList;

        // HIGHLIGHT: The logic now correctly handles both filtering and clearing the search.
        if (this.searchKey && this.searchKey.length >= 3) {
            // HIGHLIGHT: The filter now correctly uses `this.fetchedEndProducts` (the complete list).
            filteredList = this.fetchedEndProducts.filter(product =>
                (product.name?.toLowerCase().includes(this.searchKey) ||
                (product.prodCode?.toLowerCase().includes(this.searchKey))||(product.productModel?.toLowerCase().includes(this.searchKey)))
            );
        } else {
            // HIGHLIGHT: When search is cleared, it reverts to the full list.
            filteredList = [...this.fetchedEndProducts];
        }

        // HIGHLIGHT: The source for pagination is now the newly filtered list.
        this.allEndProducts = filteredList;

        // HIGHLIGHT: Pagination is reset to show the results from the first page.
        this.totalPages = Math.ceil(this.allEndProducts.length / this.pageSize);
        this.currentPage = 1;

        // HIGHLIGHT: Call the pagination function to update the UI correctly for all pages.
        this.paginateEndProducts();


    } else {
        // Updated the else block as well for consistency
        const filteredProducts = this.products.filter(product =>
            product.Name?.toLowerCase().includes(this.searchKey) ||
            product.prodCode?.toLowerCase().includes(this.searchKey)||(product.productModel?.toLowerCase().includes(this.searchKey))
        );
        this.totalPages = Math.ceil(filteredProducts.length / this.pageSize);
        this.currentPage = 1;
        this.visibleProducts = filteredProducts.slice(0, this.pageSize);
    }
}



