	/* TCR Date update Based on asset*/

	private static void setDateOfRetailFromAsset(List<Case> caseList) {
    Set<Id> assetIds = new Set<Id>();

    // Asset IDs collect 
    for (Case c : caseList) {
        if (c.AssetId != null) {
            assetIds.add(c.AssetId);
        }
    }

    if (assetIds.isEmpty()) return;

    // Asset  Delivery Date fetch 
    Map<Id, Date> assetDateMap = new Map<Id, Date>();
    for (Asset a : [
        SELECT Id, Delivery_Date__c
        FROM Asset
        WHERE Id IN :assetIds
    ]) {
        assetDateMap.put(a.Id, a.Delivery_Date__c);
    }

    // Case date set when AssetId match 
    for (Case c : caseList) {
        if (c.AssetId != null && assetDateMap.containsKey(c.AssetId)) {
            c.Date_of_Retail__c = assetDateMap.get(c.AssetId);
        }
    }
}



public static Boolean isTCRSearchUpdated = false;

private static void updateTCRSearchField(List<Case> caseList){

    List<Case> caseToUpdate = new List<Case>();
    Id tcrRecordTypeId = '012HE000000q7K6YAI';

    for(Case c : caseList){

        if(c.RecordTypeId == tcrRecordTypeId){

            if(String.isNotBlank(c.TCR_Number__c) &&
               c.TCR_Number_Search__c != c.TCR_Number__c){

                caseToUpdate.add(new Case(
                    Id = c.Id,
                    TCR_Number_Search__c = c.TCR_Number__c
                ));
            }
        }
    }

    if(!caseToUpdate.isEmpty()){
        update caseToUpdate;
    }
}
	
