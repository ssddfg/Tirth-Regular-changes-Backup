                                        <span class="badge product-type">{product.ProductType}</span>
                                     </td>
                                    <!-- <template if:false={product.AltBOM}> -->
                                    <td class="text-align-center">{product.ListPrice} </td>
                                    <td class="text-align-center">{product.SalesPrice}</td>
                                    <td class="text-align-center">{product.Quantity}</td>
                                    <td class="text-align-center">{product.TotalPrice}</td>
                                    <!--<td class="text-align-center">
                                        <span class="instruction-fields"
                                            title={product.manfInstruct}>{product.ManfInstruction}</span>
                                    </td>
                                    <td class="text-align-center">
                                        <span class="instruction-fields"
                                            title={product.logInstruct}>{product.LogInstruction}</span>
                                    </td>
                                    <td class="text-align-center">
                                        <span class="instruction-fields"
                                            title={product.addInstruct}>{product.AddInstruction}</span>
                                    </td>-->
                                    <td class="text-align-center">{product.TotalValueActualPrice}</td>
                                    <td class="text-align-center">{product.FromRateContract}</td>
                                    <td class="text-align-center">{product.DeviationPBE}</td>
                                    <td class="text-align-center">{product.DeviationRC}</td>
                                    <td class="text-align-center">{product.NDP_INCO_Price}</td>
                                    
                                    
                                    
                                    <!-- </template> -->
                                </tr>
                                <!-- <template if:true={product.altBOMList}>
                                    <template for:each={product.altBOMList} for:item="alt">
                                        <tr key={alt.Id} class="alt-bom-row">
                                            <td></td>
                                            <td class="clickable-link" data-id={alt.Id} onclick={handleNavigate} title="Click to view product">
                                                <span class="link-content">
                                                    <lightning-icon icon-name="utility:chevronright" size="xx-small"
                                                        alternative-text="Go" title="Go"></lightning-icon>
                                                    {alt.ProductName} <span class="alt-label">(ALT BOM)</span>
