public void createPricebookEntries(List<Product2> newProducts) {

    // Extract product codes from new products
    Set<String> productCodes = new Set<String>();
    for (Product2 p : newProducts) {
        if (String.isNotBlank(p.ProductCode)) {
            productCodes.add(p.ProductCode);
        }
    }

    // Call main logic
    processPricebookLines(productCodes, newProducts);
}
