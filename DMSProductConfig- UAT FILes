        console.log('Search cleared, restoring original product list.');
        this.endProducts = [...this.originalEndProducts]; // Restore original list
        this.totalPages = Math.ceil(this.endProducts.length / this.pageSize);
        this.currentPage = 1;
        this.endProducts = this.endProducts.slice(0, this.pageSize);
