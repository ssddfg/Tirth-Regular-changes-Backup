        <!-- Background image container -->
        <div class="ecatalogue-container">
            <!-- DMS / Dealer user → iframe -->
            <template if:false={isInternalUser}>
                <template if:true={url}>
                    <iframe src={url} width="100%" height="800px" frameborder="0"></iframe>
