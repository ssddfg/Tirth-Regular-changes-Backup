	public static void processPricebookLines(Set<String> productCodes, List<Product2> newProducts) {

    if (productCodes.isEmpty()) return;

    // STEP 1: Get matching Pricebook Lines
    List<Pricebook_lines__c> lineList = [
        SELECT Id, ITEM_CODE__c, LIST_HEADER_ID__c, UNIT_COST__c,
               START_DATE_ACTIVE__c, END_DATE_ACTIVE__c
        FROM Pricebook_lines__c
        WHERE ITEM_CODE__c IN :productCodes
		AND START_DATE_ACTIVE__c <= TODAY
    AND END_DATE_ACTIVE__c >= TODAY
    ];
    if (lineList.isEmpty()) return;

    // STEP 2: Collect Header IDs
    Set<String> headerIds = new Set<String>();
    for (Pricebook_lines__c pl : lineList) {
        headerIds.add(pl.LIST_HEADER_ID__c);
    }

    // STEP 3: Get Pricebook2
    Map<String, Pricebook2> pricebookMap = new Map<String, Pricebook2>();
    for (Pricebook2 pb : [
        SELECT Id, Name, Price_Book_External_Id__c, CurrencyIsoCode
        FROM Pricebook2
        WHERE Price_Book_External_Id__c IN :headerIds
        AND IsActive = TRUE
    ]) {
        pricebookMap.put(pb.Price_Book_External_Id__c, pb);
    }
    if (pricebookMap.isEmpty()) return;

    // STEP 4: ProductCode → ProductId Map
    Map<String, Id> prodCodeToId = new Map<String, Id>();
    for (Product2 p : newProducts) {
        prodCodeToId.put(p.ProductCode, p.Id);
    }

    // STEP 5: Build keys: pbId + '_' + prodId
    Set<Id> pricebookIds = new Set<Id>();
    for (Pricebook2 pb : pricebookMap.values()) {
        pricebookIds.add(pb.Id);
    }

    // Fetch existing PBE
    Map<String, PricebookEntry> existingPBEMap = new Map<String, PricebookEntry>();
    for (PricebookEntry pbe : [
        SELECT Id, Pricebook2Id, Product2Id, UnitPrice,
               Start_Date__c, End_Date__c
        FROM PricebookEntry
        WHERE Product2Id IN :prodCodeToId.values()
        AND Pricebook2Id IN :pricebookIds
    ]) {
        existingPBEMap.put(pbe.Pricebook2Id + '_' + pbe.Product2Id, pbe);
    }

    // ⭐ FINAL LISTS
    List<PricebookEntry> pbeToInsert = new List<PricebookEntry>();
    List<PricebookEntry> pbeToUpdate = new List<PricebookEntry>();

    // STEP 6: Insert OR Update logic
    for (Pricebook_lines__c pl : lineList) {

        if (prodCodeToId.containsKey(pl.ITEM_CODE__c) 
            && pricebookMap.containsKey(pl.LIST_HEADER_ID__c)) {

            Pricebook2 pb = pricebookMap.get(pl.LIST_HEADER_ID__c);
            String key = pb.Id + '_' + prodCodeToId.get(pl.ITEM_CODE__c);

            // ⭐ UPDATE EXISTING PBE — WITH START & END DATE LOGIC
            if (existingPBEMap.containsKey(key)) {

                PricebookEntry existingPBE = existingPBEMap.get(key);

                Boolean needUpdate = false;

                if (existingPBE.UnitPrice != pl.UNIT_COST__c) {
                    existingPBE.UnitPrice = pl.UNIT_COST__c;
                    needUpdate = true;
                }

                if (existingPBE.Start_Date__c != pl.START_DATE_ACTIVE__c) {
                    existingPBE.Start_Date__c = pl.START_DATE_ACTIVE__c;
                    needUpdate = true;
                }

                if (existingPBE.End_Date__c != pl.END_DATE_ACTIVE__c) {
                    existingPBE.End_Date__c = pl.END_DATE_ACTIVE__c;
                    needUpdate = true;
                }

                if (needUpdate) {
                    pbeToUpdate.add(existingPBE);
                }

                continue; // skip insert
            }

            // ⭐ INSERT NEW PBE — WITH START & END DATE LOGIC
            pbeToInsert.add(new PricebookEntry(
                Pricebook2Id     = pb.Id,
                Product2Id       = prodCodeToId.get(pl.ITEM_CODE__c),
                UnitPrice        = pl.UNIT_COST__c,
                IsActive         = true,
                UseStandardPrice = false,
                CurrencyIsoCode  = pb.CurrencyIsoCode,

                // NEW FIELDS ADDED SAME AS BATCH
                Start_Date__c    = pl.START_DATE_ACTIVE__c,
                End_Date__c      = pl.END_DATE_ACTIVE__c
            ));
        }
    }

    // ⭐ Perform DML
    if (!pbeToInsert.isEmpty()) {
        insert pbeToInsert;
    }

    if (!pbeToUpdate.isEmpty()) {
        update pbeToUpdate;
    }
}


