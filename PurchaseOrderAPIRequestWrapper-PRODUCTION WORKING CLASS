    private static String formatDate(Date inputDate) {
        Date effectiveDate = inputDate != null ? inputDate : Date.today();
        return Datetime.newInstance(effectiveDate, Time.newInstance(0, 0, 0, 0)).format('dd.MM.yyyy');
    }



